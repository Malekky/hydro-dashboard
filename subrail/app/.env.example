# --- chain (Base mainnet — product decision: no testnet) ---
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# --- Peer (zkp2p) ---
# Curator API key: enables auto gating signatures on signalIntent + authenticated quotes.
# Client-exposed for MVP; proxy server-side before production.
NEXT_PUBLIC_ZKP2P_API_KEY=
# Builder/referral fee recipient (25 bps on fulfillments)
NEXT_PUBLIC_SUBRAIL_FEE_ADDRESS=

# --- Gnosis Pay gateway (permissionless tier — no partnership needed) ---
# An OWNER key of the operator's Gnosis Pay account. Server-only; used exclusively to
# sign SIWE login messages (api.gnosispay.com), never to move funds.
GNOSIS_OPERATOR_PRIVATE_KEY=
# The operator's Gnosis Pay Safe on Gnosis Chain — friends' contributions land here as EURe.
GNOSIS_SAFE_ADDRESS=
# SIWE domain: localhost is auto-allowed; register hosted domains free at partners.gnosispay.com
GNOSISPAY_SIWE_DOMAIN=localhost:3000
GNOSISPAY_API_URL=https://api.gnosispay.com
# Pin the EURe token address on Gnosis Chain at config time (LI.FI resolves the symbol meanwhile)
NEXT_PUBLIC_GNOSIS_EURE_TOKEN=EURe

# --- post-MVP (fallback legs, renewals, fee endpoint) ---
DATABASE_URL=
SPENDER_PRIVATE_KEY=
SUBRAIL_FEE_ADDRESS=0x0000000000000000000000000000000000000000
BITREFILL_API_KEY=
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
FEATURE_LEG_B=false
FEATURE_AUTONOMOUS_RENEWALS=false

# --- solver market (docs/04-solver-market.md) ---
# GiftIntentEscrow deployed on Base (contracts/GiftIntentEscrow.sol)
NEXT_PUBLIC_GIFT_ESCROW_ADDRESS=
# Reclaim zkTLS — set once the custom claude.ai provider exists (dev.reclaimprotocol.org).
# Proxy the secret server-side before production.
NEXT_PUBLIC_RECLAIM_APP_ID=
NEXT_PUBLIC_RECLAIM_APP_SECRET=
NEXT_PUBLIC_RECLAIM_CLAUDE_PROVIDER_ID=
